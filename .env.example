# Backend used by `npm run dev`.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Leave this empty on Vercel. vercel.json proxies /api to the Render backend so
# LINE Login and session cookies remain first-party on colorseek.vercel.app.
# Set a full URL only for deployments that host frontend and backend together
# under another cookie-compatible domain.
VITE_API_BASE_URL=

# Legacy fallback used only when VITE_API_BASE_URL is empty. In production,
# prefer setting VITE_API_BASE_URL and leave this empty.
VITE_LINE_LOGIN_URL=https://your-api-domain.example/api/v1/auth/line/login

# LINE Developers > LIFF app ID. The booking page uses this for one-tap login.
VITE_LIFF_ID=2010814211-P0FrOsZT

# Backend endpoint that verifies the LIFF ID token and creates the member session.
VITE_LIFF_LOGIN_PATH=/api/v1/auth/line/liff
